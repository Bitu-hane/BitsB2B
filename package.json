{
  "name": "bitsb2b-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/backend",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -n \"WEB,API\" -c \"cyan,yellow\" \"npm run dev --workspace=apps/web\" \"npm run start:dev --workspace=apps/backend\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:backend": "npm run start:dev --workspace=apps/backend",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nx": "^20.0.0"
  }
}
